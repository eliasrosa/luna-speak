# Secrets de deploy do LunaSpeak (NÃO versionar o .env.deploy real — só este .example).
# Copie para .env.deploy e preencha. Usado por scripts/deploy-manual.sh.

# Token do bot Telegram (obrigatório). Gere/rotacione no @BotFather.
TELEGRAM_BOT_TOKEN=

# Voz e conversão (opcionais — default abaixo).
EDGE_VOICE=pt-BR-FranciscaNeural
EDGE_TIMEOUT=8
OPUS_BITRATE=32k
