# Token do bot Telegram (NUNCA versionar o .env real)
TELEGRAM_BOT_TOKEN=
# Voz padrão (Edge-TTS). Fallback offline usa Piper faber automaticamente.
EDGE_VOICE=pt-BR-FranciscaNeural
EDGE_TIMEOUT=8
OPUS_BITRATE=32k
# Gate de "resposta curta": teto de caracteres do texto. Acima disso o /say recusa com
# HTTP 413 {reason:"too_long"} em vez de gerar áudio longo. 0 desliga o gate.
# ~600 chars ≈ até ~1 min de fala.
SAY_MAX_CHARS=600
# Teste: força o fallback Piper (pula o Edge-TTS) sem cortar a rede. Deixe vazio em produção.
FORCE_PIPER=
# Nível de log (DEBUG, INFO, WARNING, ERROR). Padrão INFO.
LOG_LEVEL=INFO
