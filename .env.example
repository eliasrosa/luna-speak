# Token do bot Telegram (NUNCA versionar o .env real)
TELEGRAM_BOT_TOKEN=
# Voz padrão (Edge-TTS). Fallback offline usa Piper faber automaticamente.
EDGE_VOICE=pt-BR-FranciscaNeural
EDGE_TIMEOUT=8
OPUS_BITRATE=32k
# Teste: força o fallback Piper (pula o Edge-TTS) sem cortar a rede. Deixe vazio em produção.
FORCE_PIPER=
